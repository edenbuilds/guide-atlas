# --- Database ---------------------------------------------------------------
# PostgreSQL (Prisma Postgres, Neon, Supabase, RDS, local docker…). `npm run db:deploy` applies migrations.
DATABASE_URL="postgresql://user:password@host:5432/guide_atlas?sslmode=require"
# Quick throwaway database with no account:  npx create-db@latest create --env .env
# Local SQLite fallback: set provider = "sqlite" in prisma/schema.prisma, DATABASE_URL="file:./dev.db",
# delete prisma/migrations and run `npx prisma migrate dev --name init`.

# --- Scraping engine --------------------------------------------------------
FIRECRAWL_API_KEY="fc-..."
# Optional overrides (auto-tuned from /v2/concurrency-check when omitted)
# FIRECRAWL_MAX_CONCURRENCY=2
# FIRECRAWL_RPM=60

# Optional Apify fallback for domains that block Firecrawl (social networks, bot walls)
# APIFY_TOKEN="apify_api_..."
# APIFY_CONTENT_ACTOR="apify~website-content-crawler"
# APIFY_SEARCH_ACTOR="apify~google-search-scraper"

# --- Ingest API -------------------------------------------------------------
INGEST_API_URL="http://localhost:3000/api/guides/ingest"
# Set to require `Authorization: Bearer <key>` on POST /api/guides/ingest and PATCH /api/guides/runs
# INGEST_API_KEY="change-me"

# --- Scraper defaults -------------------------------------------------------
# SCRAPER_MODE=llm          # llm | regex
# SCRAPER_MAX_CREDITS=5000
# SCRAPER_LOG_LEVEL=info    # debug | info | warn | error
